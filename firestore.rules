rules_version = '2';

// The website saves bookings and enquiries from its server with the Admin SDK, which bypasses these rules.
// Browsers get no direct access, so nobody can read customer details or write spam straight into the database.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
